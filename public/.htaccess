Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header onsuccess unset X-Powered-By
    Header onsuccess unset X-Content-Type-Options
    Header onsuccess unset X-Frame-Options
    Header onsuccess unset Referrer-Policy
    Header onsuccess unset Permissions-Policy
    Header onsuccess unset Cross-Origin-Opener-Policy
    Header onsuccess unset Cross-Origin-Resource-Policy
    Header onsuccess unset Content-Security-Policy
    Header always unset X-Powered-By
    Header always unset X-Content-Type-Options
    Header always unset X-Frame-Options
    Header always unset Referrer-Policy
    Header always unset Permissions-Policy
    Header always unset Cross-Origin-Opener-Policy
    Header always unset Cross-Origin-Resource-Policy
    Header always unset Content-Security-Policy
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
</IfModule>
